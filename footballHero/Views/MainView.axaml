<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:footballHero.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:footballHero.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="footballHero.Views.MainView"
             x:DataType="vm:MainViewModel">

    <!-- 1. The Translator: Tells Avalonia which View matches which ViewModel -->
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LoginPageViewModel}">
            <views:LoginPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <views:MainMenu />
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- 2. The Picture Frame: Automatically displays whatever CurrentPage is set to -->
    <ContentControl Content="{Binding CurrentPage}" />

</UserControl>